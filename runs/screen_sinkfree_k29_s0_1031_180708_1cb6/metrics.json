 "selector_meta": {
  "method": "last-block CLS attention (MaskedKD) with high-norm artifact tokens (per-image median+3MAD of the block-10 token norms) excluded",
  "paper": "Darcet et al. ICLR 2024 (Vision Transformers Need Registers: high-norm artifact tokens); Son et al. ECCV 2024 (MaskedKD)",
  "why": "the student's high-norm tokens absorb last-block CLS attention but are not informative inputs for the teacher; skipping them keeps the masked teacher's soft label closer to the full one (H-C10)",
  "vs_maskedkd": "same attention score, but tokens whose block-10 norm is an outlier within the image get the lowest score, so the next-attended tokens fill the budget",
  "prior_art": "registers (Darcet 2024) retrain with extra tokens to remove artifacts; here the artifacts are detected per image at no training cost and only used to steer which tokens the teacher sees",
